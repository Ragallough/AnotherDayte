  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 6
  indentLevel: 1
  storyText: Seven nights of stilton blue cheese before bed gave me one of the strangest
    images and most emotional dreams I've ever logged.
  description: 
  character: {fileID: 759643427}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
