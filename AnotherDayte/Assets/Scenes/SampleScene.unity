  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 25
  indentLevel: 1
  storyText: 'Eh, I don''t know if it''s all that bad. Look here, punk. If you have
    any trouble to cause, you best be taking it somewhere we ain''t. '
  description: 
  character: {fileID: 76870825}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
